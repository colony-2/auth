{
  "name": "authz-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:authz": "wrangler dev --config wrangler.demo-authz.jsonc --port 8787",
    "dev:authn": "wrangler dev --config wrangler.authn.jsonc --port 8788",
    "dev:management": "wrangler dev --config wrangler.management.jsonc --port 8789",
    "dev:management-ui": "vite --config vite.config.ts",
    "dev:demo-api": "wrangler dev --config examples/project-workspace/wrangler.jsonc --port 8790",
    "demo:up": "node scripts/demo-stack.mjs",
    "demo:seed": "node scripts/demo-seed.mjs",
    "demo:token": "node scripts/demo-token.mjs",
    "demo:request": "node scripts/demo-request.mjs",
    "demo:test": "node scripts/demo-stack.mjs --test",
    "deploy:cloudflare": "node scripts/cloudflare-deploy.mjs",
    "deploy:cloudflare:dry-run": "node scripts/cloudflare-deploy.mjs --dry-run",
    "smoke:cloudflare": "node scripts/cloudflare-smoke.mjs",
    "rollback:config": "node scripts/rollback-version.mjs",
    "build:management-ui": "vite build --config vite.config.ts",
    "deploy:authn": "wrangler deploy --config wrangler.authn.jsonc",
    "deploy:authn:dry-run": "wrangler deploy --dry-run --config wrangler.authn.jsonc",
    "deploy:management": "wrangler deploy --config wrangler.management.jsonc",
    "deploy:management:dry-run": "wrangler deploy --dry-run --config wrangler.management.jsonc",
    "deploy:management-ui": "npm run build:management-ui && wrangler deploy --config wrangler.ui.jsonc",
    "deploy:management-ui:dry-run": "npm run build:management-ui && wrangler deploy --dry-run --config wrangler.ui.jsonc",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "typecheck": "tsc --noEmit",
    "typecheck:ui": "tsc --noEmit -p ui/tsconfig.json",
    "test": "vitest run",
    "test:contract": "vitest run tests/management/openapi-contract.test.ts",
    "test:ui": "vitest run tests/ui",
    "generate:management-client": "openapi-typescript openapi/management-service.openapi.yaml -o src/management/generated-api.ts",
    "test:integration": "node scripts/test-worker.mjs",
    "verify": "npm run typecheck && npm run typecheck:ui && npm test && npm run test:integration && npm run demo:test && npm run deploy:cloudflare:dry-run -- --env staging",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "@cedar-policy/cedar-wasm": "4.9.1",
    "jose": "6.2.2",
    "lucide-react": "^0.468.0",
    "openapi-fetch": "^0.14.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260405.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.9.1",
    "typescript": "5.9.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wrangler": "4.80.0"
  }
}
