{
  "name": "authz-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:authn": "wrangler dev --config wrangler.authn.jsonc --port 8788",
    "deploy:authn": "wrangler deploy --config wrangler.authn.jsonc",
    "deploy:authn:dry-run": "wrangler deploy --dry-run --config wrangler.authn.jsonc",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node scripts/test-worker.mjs",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "@cedar-policy/cedar-wasm": "4.9.1",
    "jose": "6.2.2",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260405.1",
    "@types/node": "^24.3.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "4.80.0"
  }
}
